# Copie ce fichier en `.env` et remplis les deux clés.

# Clé API Anthropic (analyse de la photo) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Clé SerpApi (recherche visuelle Google Lens) — https://serpapi.com/manage-api-key
# ~100 recherches gratuites/mois. Sans cette clé, l'appli propose seulement des liens de recherche.
SERPAPI_KEY=...
